# Copy to backend/.env locally; run: go run ./cmd/amlens serve --env-file .env
# Existing environment variables win. Never put real keys in this example.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ANALYSIS_STORAGE_DIR=out/api
ANALYSIS_DATABASE=out/analyses.db

# Optional; graph analysis and CSV work without AI.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=30
